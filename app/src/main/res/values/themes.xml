<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.TravelingSalesman" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cool_primary</item>
        <item name="colorPrimaryVariant">@color/cool_primary_dark</item>
        <item name="colorSecondary">@color/cool_accent</item>
